<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- The email body only ever inlines the primary palette, so only single-mode
    themes declare a scheme (keeping a dark terminal theme from being
    auto-inverted by dark-mode clients). A dual-mode theme (classic) renders
    light-only here; omitting the meta preserves the pre-themes client
    behavior rather than advertising dark support the email doesn't have. -#}
{% if t.dark_palette is none %}
<meta name="color-scheme" content="{{ t.color_scheme }}">
<meta name="supported-color-schemes" content="{{ t.color_scheme }}">
{% endif %}
<title>daily scoop · {{ date|e }}</title>
</head>
<body style="margin:0; padding:0; background:{{ p.bg }}; font-family:{{ t.font_body }}; color:{{ p.fg }}; -webkit-text-size-adjust:100%;">
  {% if web_nav %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ p.bg }};">
    <tr>
      <td align="center" style="padding:14px 12px 0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;">
          <tr>
            <td style="font-size:{{ fs(13) }}; color:{{ p.muted }};">
              <a href="/discover" style="color:{{ p.muted }}; text-decoration:none;">discover</a>
              &nbsp;&middot;&nbsp;
              <a href="/admin" style="color:{{ p.muted }}; text-decoration:none;">admin</a>
              &nbsp;&middot;&nbsp;
              <a href="/emails" style="color:{{ p.muted }}; text-decoration:none;">emails</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  {% endif %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ p.bg }};">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px; background:{{ p.panel }}; border:1px solid {{ p.border }}; border-radius:{{ t.radius_sm }};">
          <tr>
            <td style="padding:24px 24px 12px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="font-family:{{ t.font_brand }}; font-size:{{ fs(24) }}; font-weight:700; letter-spacing:-0.01em; color:{{ p.fg }};">
                    daily scoop
                  </td>
                  <td align="right" style="font-size:{{ fs(13) }}; color:{{ p.muted }};">
                    {{ date|e }}
                  </td>
                </tr>
                {% if weather_line %}
                <tr>
                  <td colspan="2" style="font-size:{{ fs(12) }}; color:{{ p.muted }}; padding-top:4px;">
                    {{ weather_line|e }}
                  </td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>

          {% if intro %}
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }}; font-size:{{ fs(15) }}; line-height:1.55; color:{{ p.fg }};">
              {{ intro|e }}
            </td>
          </tr>
          {% endif %}

          {% if quote %}
          {#- The quote of the day: an epigraph under the intro, votable
              like everything else via its synthetic signed URL. -#}
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:top; padding-right:12px;">
                    <div style="font-size:{{ fs(16) }}; line-height:1.5; font-style:italic; color:{{ p.fg }}; margin:0 0 6px 0;">
                      &ldquo;{{ quote.text|e }}&rdquo;
                    </div>
                    <div style="font-size:{{ fs(13) }}; color:{{ p.muted }}; margin:0;">
                      &mdash; {{ quote.author|e }}{% if quote.source %}, <em>{{ quote.source|e }}</em>{% endif %}{% if quote.tradition %} &middot; {{ quote.tradition|e }}{% endif %}
                    </div>
                  </td>
                  <td align="right" style="vertical-align:top; white-space:nowrap; width:96px;">
                    <a href="{{ quote.up_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.ok }}; background:{{ p.ok_bg }}; border:1px solid {{ p.ok_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+</a>
                    <a href="{{ quote.down_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.bad }}; background:{{ p.bad_bg }}; border:1px solid {{ p.bad_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">&#8722;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          {% if deepdive %}
          <tr>
            <td style="padding:20px 24px 8px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0;">
                You asked
              </div>
              <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:2px 0 0 0;">
                {{ deepdive.topic|e }}
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-size:{{ fs(17) }}; line-height:1.35; font-weight:600; color:{{ p.fg }}; margin:0 0 10px 0;">
                {{ deepdive.title|e }}
              </div>
              {% for para in deepdive.paragraphs %}
              <div style="font-size:{{ fs(15) }}; line-height:1.55; color:{{ p.fg }}; margin:0 0 12px 0;">
                {{ para|e }}
              </div>
              {% endfor %}
            </td>
          </tr>
          {% endif %}

          {#- One tech-fact essay (mid or end slot): section header, title,
              genre subline, ~500 words of paragraphs, and the same signed
              +/- voting cell as articles. -#}
          {% macro fact_block(fact, header) %}
          <tr>
            <td style="padding:20px 24px 8px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0;">
                {{ header }}
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:top; padding-right:12px;">
                    <div style="font-size:{{ fs(17) }}; line-height:1.35; font-weight:600; color:{{ p.fg }}; margin:0 0 4px 0;">
                      {{ fact.title|e }}
                    </div>
                    {% if fact.genre %}
                    <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 10px 0;">
                      {{ fact.genre|e }}
                    </div>
                    {% endif %}
                    {% for para in fact.paragraphs %}
                    <div style="font-size:{{ fs(15) }}; line-height:1.55; color:{{ p.fg }}; margin:0 0 12px 0;">
                      {{ para|e }}
                    </div>
                    {% endfor %}
                  </td>
                  <td align="right" style="vertical-align:top; white-space:nowrap; width:96px;">
                    <a href="{{ fact.up_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.ok }}; background:{{ p.ok_bg }}; border:1px solid {{ p.ok_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+</a>
                    <a href="{{ fact.down_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.bad }}; background:{{ p.bad_bg }}; border:1px solid {{ p.bad_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">&#8722;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endmacro %}
          {% for pick in picks %}
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:top; padding-right:12px;">
                    <div style="font-size:{{ fs(17) }}; line-height:1.35; font-weight:600; margin:0 0 4px 0;">
                      <a href="{{ pick.url|e }}" target="_blank" rel="noopener noreferrer" style="color:{{ p.accent }}; text-decoration:none;">{{ pick.title|e }}</a>
                    </div>
                    <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 8px 0;">
                      {{ pick.source|e }}
                    </div>
                    <div style="font-size:{{ fs(15) }}; line-height:1.5; color:{{ p.fg }}; margin:0;">
                      {{ pick.blurb|e }}
                    </div>
                  </td>
                  <td align="right" style="vertical-align:top; white-space:nowrap; width:96px;">
                    <a href="{{ pick.up_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.ok }}; background:{{ p.ok_bg }}; border:1px solid {{ p.ok_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+</a>
                    <a href="{{ pick.down_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.bad }}; background:{{ p.bad_bg }}; border:1px solid {{ p.bad_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">&#8722;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}

          {% if fact_mid %}{{ fact_block(fact_mid, "Tech fact of the day") }}{% endif %}

          {% if web_articles %}
          <tr>
            <td style="padding:20px 24px 8px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0;">
                From around the web
              </div>
            </td>
          </tr>
          {% for w in web_articles %}
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:top; padding-right:12px;">
                    <div style="font-size:{{ fs(17) }}; line-height:1.35; font-weight:600; margin:0 0 4px 0;">
                      <a href="{{ w.url|e }}" target="_blank" rel="noopener noreferrer" style="color:{{ p.accent }}; text-decoration:none;">{{ w.title|e }}</a>
                    </div>
                    <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 8px 0;">
                      {% if w.source %}{{ w.source|e }}{% endif %}{% if w.points is not none %} &middot; &#9650; {{ w.points }}{% endif %}{% if w.comments is not none %} &middot; {{ w.comments }} comments{% endif %}{% if w.comments_url %} &middot; <a href="{{ w.comments_url|e }}" target="_blank" rel="noopener noreferrer" style="color:{{ p.muted }};">discussion</a>{% endif %}
                    </div>
                    {% if w.blurb %}
                    <div style="font-size:{{ fs(15) }}; line-height:1.5; color:{{ p.fg }}; margin:0;">
                      {{ w.blurb|e }}
                    </div>
                    {% endif %}
                  </td>
                  <td align="right" style="vertical-align:top; white-space:nowrap; width:96px;">
                    <a href="{{ w.up_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.ok }}; background:{{ p.ok_bg }}; border:1px solid {{ p.ok_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+</a>
                    <a href="{{ w.down_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.bad }}; background:{{ p.bad_bg }}; border:1px solid {{ p.bad_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">&#8722;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}
          {% endif %}

          {% if random_articles %}
          <tr>
            <td style="padding:20px 24px 8px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0;">
                Off your beat
              </div>
              <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:2px 0 0 0;">
                Popular this week, nothing to do with computers
              </div>
            </td>
          </tr>
          {% for r in random_articles %}
          <tr>
            <td style="padding:20px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:top; padding-right:12px;">
                    <div style="font-size:{{ fs(17) }}; line-height:1.35; font-weight:600; margin:0 0 4px 0;">
                      <a href="{{ r.url|e }}" target="_blank" rel="noopener noreferrer" style="color:{{ p.accent }}; text-decoration:none;">{{ r.title|e }}</a>
                    </div>
                    {% if r.source %}
                    <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 8px 0;">
                      {{ r.source|e }}
                    </div>
                    {% endif %}
                    {% if r.blurb %}
                    <div style="font-size:{{ fs(15) }}; line-height:1.5; color:{{ p.fg }}; margin:0;">
                      {{ r.blurb|e }}
                    </div>
                    {% endif %}
                  </td>
                  <td align="right" style="vertical-align:top; white-space:nowrap; width:96px;">
                    <a href="{{ r.up_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.ok }}; background:{{ p.ok_bg }}; border:1px solid {{ p.ok_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+</a>
                    <a href="{{ r.down_link|e }}" style="display:inline-block; padding:8px 12px; margin-left:4px; font-family:{{ t.font_mono }}; font-size:{{ fs(18) }}; line-height:1; color:{{ p.bad }}; background:{{ p.bad_bg }}; border:1px solid {{ p.bad_border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">&#8722;</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}
          {% endif %}

          {% if discoveries %}
          <tr>
            <td style="padding:20px 24px 8px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0;">
                Sources you don&rsquo;t follow yet
              </div>
            </td>
          </tr>
          {% for disc in discoveries %}
          <tr>
            <td style="padding:16px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <div style="font-size:{{ fs(16) }}; line-height:1.35; font-weight:600; margin:0 0 4px 0;">
                <a href="{{ disc.url|e }}" target="_blank" rel="noopener noreferrer" style="color:{{ p.accent }}; text-decoration:none;">{{ disc.title|e }}</a>
              </div>
              {% if disc.source %}
              <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 8px 0;">
                {{ disc.source|e }}
              </div>
              {% endif %}
              {% if disc.reason %}
              <div style="font-size:{{ fs(14) }}; line-height:1.5; color:{{ p.fg }}; margin:0 0 10px 0;">
                {{ disc.reason|e }}
              </div>
              {% endif %}
              {% if disc.subscribe_link %}
              <div style="margin:0;">
                <a href="{{ disc.subscribe_link|e }}" style="display:inline-block; padding:6px 12px; font-size:{{ fs(13) }}; font-weight:600; color:{{ p.accent }}; background:{{ p.accent_bg }}; border:1px solid {{ p.border }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">+ Subscribe</a>
              </div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
          {% endif %}

          {% if fact_end %}{{ fact_block(fact_end, "One more fact") }}{% endif %}

          <tr>
            <td align="center" style="padding:22px 24px; border-bottom:1px solid {{ p.border_soft }};">
              <a href="{{ home_url|e }}" style="display:inline-block; padding:11px 20px; font-size:{{ fs(15) }}; font-weight:600; color:{{ p.accent_fg }}; background:{{ p.accent }}; border-radius:{{ t.radius_sm }}; text-decoration:none;">Open daily scoop &rarr;</a>
              <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin-top:8px;">This edition on the web &mdash; read, vote, and browse the archive.</div>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:16px 24px 24px 24px; font-size:{{ fs(11) }}; color:{{ p.muted }};">
              daily scoop · {{ picks|length }} picks today
              <br>
              <a href="{{ home_url|e }}" style="color:{{ p.muted }}; text-decoration:underline;">daily scoop</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  {% if deepdive_pending is not none %}
  {#- Web-only ("/"): the deep-dive request box. Never rendered in sent
      emails (the context key stays None there). -#}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ p.bg }};">
    <tr>
      <td align="center" style="padding:0 12px 32px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px; background:{{ p.panel }}; border:1px solid {{ p.border }}; border-radius:{{ t.radius_sm }};">
          <tr>
            <td style="padding:20px 24px;">
              <div style="font-family:{{ t.font_brand }}; font-size:{{ fs(15) }}; font-weight:700; color:{{ p.fg }}; margin:0 0 4px 0;">
                Request a deep dive
              </div>
              <div style="font-size:{{ fs(12) }}; color:{{ p.muted }}; margin:0 0 12px 0;">
                {% if deepdive_pending == 0 %}Ask for a ~500-word explainer &mdash; it arrives in the next edition.{% else %}{{ deepdive_pending }} queued &mdash; the next one arrives in tomorrow&rsquo;s edition.{% endif %}
              </div>
              <form method="post" action="/api/deepdive" style="margin:0;">
                <input type="text" name="topic" maxlength="200" required placeholder="e.g. how does BGP routing actually work?" style="width:70%; padding:9px 12px; font-size:{{ fs(14) }}; font-family:{{ t.font_body }}; color:{{ p.fg }}; background:{{ p.bg }}; border:1px solid {{ p.border }}; border-radius:{{ t.radius_sm }};">
                <button type="submit" style="padding:9px 16px; font-size:{{ fs(14) }}; font-weight:600; font-family:{{ t.font_body }}; color:{{ p.accent_fg }}; background:{{ p.accent }}; border:1px solid {{ p.accent }}; border-radius:{{ t.radius_sm }}; cursor:pointer;">Queue it</button>
              </form>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  {% endif %}
</body>
</html>
